# CMake helpers for the new tree (include/rtcd, src/, apps/, tests/). The old stack under RTCD/ does not use them.
#
#   rtcd_register_new_target(<target>...)
#       Adds targets to AllNew (top-level CMakeLists.txt). Every helper below registers what it creates; call it
#       yourself for targets made with plain add_library / add_executable.
#
#   rtcd_add_optix_ir(<target> SOURCES <a.cu> [<b.cu> ...]
#                     [INCLUDE_DIRS <dir>...] [LINK <target>...] [OPTIONS <nvcc option>...])
#       Compiles each .cu to OptiX IR (one OBJECT library per source, CUDA_OPTIX_COMPILATION; works with Ninja and
#       Visual Studio) and embeds the bytes into the STATIC library <target>, so binaries never load IR from a
#       (build-tree) path. For a source <name>.cu the library defines
#           namespace rtcd::embedded { extern const unsigned char <target>_<name>[];
#                                      extern const std::size_t   <target>_<name>_size; }
#       (non-identifier characters of <name> become '_'), declared in the generated header
#       <<target>_embedded.h> on the PUBLIC include path of <target>. IR sources see ${PROJECT_SOURCE_DIR}/include,
#       their own directory and OptiX; INCLUDE_DIRS / LINK add more (LINK only for include paths/definitions: an
#       OptiX IR object is never linked). Compile options follow the old stack's cuda_compile_and_embed
#       (cmake/CUDA_Macros.cmake): -lineinfo, fast math, relocatable device code; -G in Debug.
#       Compile-time variants (e.g. curve degree) belong in the .cu as templates / explicit instantiations.
#
#   rtcd_add_new_test(<name> LABEL new_unit|new_gpu SOURCES <src>... [LIBS <target>...] [ARGS <arg>...])
#       GoogleTest executable in bin/Tests/new, registered with ctest under LABEL (new_unit: no GPU needed;
#       new_gpu: needs a GPU). Runs with the repository root as working directory (data/ is reachable as ./data).
#       The old stack's golden tests keep the label `regression`.
#
#   rtcd_add_app(<name> SOURCES <src>... [LIBS <target>...])
#       Executable in bin/apps.

function(rtcd_register_new_target)
  set_property(GLOBAL APPEND PROPERTY RTCD_NEW_TARGETS ${ARGN})
endfunction()

set(RTCD_EMBED_SCRIPT "${CMAKE_CURRENT_LIST_DIR}/rtcd_embed_binary.cmake")

function(rtcd_add_optix_ir target)
  cmake_parse_arguments(PARSE_ARGV 1 arg "" "" "SOURCES;INCLUDE_DIRS;LINK;OPTIONS")
  if(NOT arg_SOURCES)
    message(FATAL_ERROR "rtcd_add_optix_ir(${target}): no SOURCES")
  endif()

  set(gen_dir "${CMAKE_CURRENT_BINARY_DIR}/${target}_embedded")
  set(header "${gen_dir}/${target}_embedded.h")
  set(header_text "// Generated by rtcd_add_optix_ir (cmake/RTCDTargets.cmake). Do not edit.\n#pragma once\n#include <cstddef>\n\nnamespace rtcd::embedded {\n")
  set(gen_sources "")
  set(ir_targets "")

  foreach(src IN LISTS arg_SOURCES)
    get_filename_component(name "${src}" NAME_WE)
    string(MAKE_C_IDENTIFIER "${target}_${name}" symbol)
    set(ir_target "${symbol}_ir")

    add_library(${ir_target} OBJECT "${src}")
    set_target_properties(${ir_target} PROPERTIES
      CUDA_OPTIX_COMPILATION ON
      FOLDER "OptixIR")
    target_compile_options(${ir_target} PRIVATE
      --generate-line-info -use_fast_math --relocatable-device-code=true $<$<CONFIG:Debug>:-G> ${arg_OPTIONS})
    target_include_directories(${ir_target} PRIVATE
      ${PROJECT_SOURCE_DIR}/include ${CMAKE_CURRENT_SOURCE_DIR} ${arg_INCLUDE_DIRS})
    target_link_libraries(${ir_target} PRIVATE OptiX::OptiX ${arg_LINK})

    set(out_cpp "${gen_dir}/${symbol}.cpp")
    add_custom_command(
      OUTPUT "${out_cpp}"
      COMMAND ${CMAKE_COMMAND} -DINPUT=$<TARGET_OBJECTS:${ir_target}> -DOUTPUT=${out_cpp} -DSYMBOL=${symbol}
              -P "${RTCD_EMBED_SCRIPT}"
      DEPENDS $<TARGET_OBJECTS:${ir_target}> "${RTCD_EMBED_SCRIPT}"
      COMMENT "Embedding OptiX IR ${name} as rtcd::embedded::${symbol}"
      VERBATIM)
    list(APPEND gen_sources "${out_cpp}")
    list(APPEND ir_targets ${ir_target})
    string(APPEND header_text "    extern const unsigned char ${symbol}[];\n    extern const std::size_t ${symbol}_size;\n")
  endforeach()

  string(APPEND header_text "} // namespace rtcd::embedded\n")
  file(CONFIGURE OUTPUT "${header}" CONTENT "${header_text}")

  add_library(${target} STATIC ${gen_sources} "${header}")
  add_dependencies(${target} ${ir_targets})
  target_include_directories(${target} PUBLIC "${gen_dir}")
  set_target_properties(${target} PROPERTIES FOLDER "rtcd")
  rtcd_register_new_target(${target})
endfunction()

function(rtcd_add_new_test name)
  cmake_parse_arguments(PARSE_ARGV 1 arg "" "LABEL" "SOURCES;LIBS;ARGS")
  if(NOT arg_LABEL STREQUAL "new_unit" AND NOT arg_LABEL STREQUAL "new_gpu")
    message(FATAL_ERROR "rtcd_add_new_test(${name}): LABEL must be new_unit or new_gpu, got '${arg_LABEL}'")
  endif()
  add_executable(${name} ${arg_SOURCES})
  target_link_libraries(${name} PRIVATE ${arg_LIBS} GTest::gtest GTest::gtest_main)
  set_target_properties(${name} PROPERTIES
    FOLDER "rtcd/tests"
    RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/bin/Tests/new)
  add_test(NAME ${name} COMMAND ${name} ${arg_ARGS} WORKING_DIRECTORY ${PROJECT_SOURCE_DIR})
  set_tests_properties(${name} PROPERTIES LABELS ${arg_LABEL})
  rtcd_register_new_target(${name})
endfunction()

function(rtcd_add_app name)
  cmake_parse_arguments(PARSE_ARGV 1 arg "" "" "SOURCES;LIBS")
  add_executable(${name} ${arg_SOURCES})
  target_link_libraries(${name} PRIVATE ${arg_LIBS})
  set_target_properties(${name} PROPERTIES
    FOLDER "rtcd/apps"
    RUNTIME_OUTPUT_DIRECTORY ${CMAKE_BINARY_DIR}/bin/apps)
  rtcd_register_new_target(${name})
endfunction()

# rtcd_add_child_directories([EXCLUDE <dir>...])
# add_subdirectory() for every direct child of the current source dir that has a CMakeLists.txt (apps/, tests/:
# agents add a folder without editing a shared list), except the EXCLUDE'd ones (added elsewhere). Re-run
# configure after adding a folder.
function(rtcd_add_child_directories)
  cmake_parse_arguments(PARSE_ARGV 0 arg "" "" "EXCLUDE")
  file(GLOB children LIST_DIRECTORIES true RELATIVE "${CMAKE_CURRENT_SOURCE_DIR}" "${CMAKE_CURRENT_SOURCE_DIR}/*")
  list(SORT children)
  foreach(child IN LISTS children)
    if(child IN_LIST arg_EXCLUDE)
      continue()
    endif()
    if(IS_DIRECTORY "${CMAKE_CURRENT_SOURCE_DIR}/${child}" AND EXISTS "${CMAKE_CURRENT_SOURCE_DIR}/${child}/CMakeLists.txt")
      add_subdirectory(${child})
    endif()
  endforeach()
endfunction()
